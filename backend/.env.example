# Copiar a .env (no se sube al repositorio)

# Proveedor de visión que se evalúa en 06C
VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite

# Base de datos donde se guardan los resultados
MONGODB_URI=
MONGODB_DB=

# Clave que envía la placa en X-Device-Key
DEVICE_KEY=
PORT=3000
UMBRAL_CONFIANZA=0.70
TIMEOUT_PROVEEDOR_MS=12000
